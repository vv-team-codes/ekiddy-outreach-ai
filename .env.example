# ==================================================
# ekiddy OUTREACH AI — ENVIRONMENT CONFIGURATION
# Copy to .env and replace placeholder values.
# NEVER commit real secrets to source control.
# ==================================================

# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,https://app.ekiddy.com

# Database (leave blank in local dev to use embedded mongodb-memory-server)
MONGODB_URI=

# Redis / BullMQ (leave blank in local dev to use in-process fallback queue)
REDIS_URL=

# Security & Encryption
JWT_SECRET=replace-with-a-64-char-random-secret-key
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=replace-with-a-32-byte-hex-or-passphrase-secret

# Optional Firebase Auth
FIREBASE_PROJECT_ID=

# Firebase Admin SDK (backend only). Paste the full service-account JSON
# on ONE line, or set GOOGLE_APPLICATION_CREDENTIALS to the JSON file path.
# NEVER commit a real service-account key.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# AI / LLM Providers
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Email Sending & Webhooks
EMAIL_PROVIDER=sandbox
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_DEFAULT=outreach@app.ekiddy.com
EMAIL_WEBHOOK_SECRET=replace-with-email-webhook-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Licensed B2B Lead Data & Verification Providers
DATA_PROVIDER_TYPE=demo
DATA_PROVIDER_API_KEY=
EMAIL_VERIFIER_API_KEY=

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google-calendar/callback

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production Domain (Caddy)
PRODUCTION_DOMAIN=app.ekiddy.com
