{$PRODUCTION_DOMAIN:app.ekiddy.com} {
    encode gzip zstd

    @api path /api/*
    handle @api {
        reverse_proxy backend:4000
    }

    handle {
        reverse_proxy frontend:80
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format json
    }
}
